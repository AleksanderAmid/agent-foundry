{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Foundry portable skill metadata profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
